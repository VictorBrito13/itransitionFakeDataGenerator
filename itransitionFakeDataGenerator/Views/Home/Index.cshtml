@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex">
    @{
        int seed = (int)(TempData["seed"] ?? 0);
        int limit = (int)(TempData["limit"] ?? 20);
        string region = (string)(TempData["region"] ?? "es_MX");
        int errors = (int)(TempData["errors"] ?? 0);
    }

    @* Settings to generate data *@
    <form action="/Home/Index" id="formGetData" class="border-bottom p-3 d-flex align-items-start justify-content-evenly w-100" method="get">
        <div>
            <label for="region">Region</label>
            <select name="region" id="region" class="form-select" data-region="@region">
                @{
                    Dictionary<string, string> supportedRegions = (Dictionary<string, string>) TempData["supportedRegions"];
                    if(supportedRegions != null) {
                        foreach(KeyValuePair<string, string> kvp in supportedRegions) {
                            if(kvp.Key == region) {
                                <option selected="selected" value="@kvp.Key">@kvp.Value</option>
                            } else {
                                <option value="@kvp.Key">@kvp.Value</option>
                            }
                        }
                    }
                }
            </select>
        </div>
        <div>
            <label for="control-error-input">Errors</label>
            <input class="form-range" type="range" value="@(errors / 100)" min="0" max="10" id="control-error-slide">
            <input class="form-control" type="number" name="errors" value="@(errors)" min="0" max="1000" id="control-error-input">
        </div>
        <div>
            <label for="seed">Seed</label>
            <button type="button" id="btn-random-seed" class="btn bg-transparent"><i class="bi bi-shuffle"></i></button>
            <input class="form-control" type="number" name="seed" id="seed" value="@(seed)">
            <input type="hidden" name="limit" id="limit" value="@(limit)">
        </div>
        <a href="" class="btn btn-primary" download="" id="download-file">Export</a>
    </form>
</div>
<div style="height: 75vh; overflow: auto;" id="tableContainer">
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Index</th>
                <th scope="col">ID</th>
                <th scope="col">Full name</th>
                <th scope="col">Address</th>
                <th scope="col">Phone Number</th>
            </tr>
        </thead>
        <tbody id="table-body">
        </tbody>
    </table>


    <script>
        let page = 1;
        let totalRecords = 0;
        let isLoading = false;

        async function getData(url, append) {
            if (isLoading) return;
            isLoading = true;

            try {
                const data = await fetch(url);
                const json = await data.json();
                renderData(json, append);
            } finally {
                isLoading = false;
            }
        }

        const $tbody = document.getElementById("table-body");

        function renderData(data, append) {
            if (!append) {
                $tbody.innerHTML = '';
                totalRecords = 0;
            }

            data.forEach(user => {
                totalRecords++;
                const $tr = document.createElement("tr");

                const $indexTd = document.createElement("td");
                $indexTd.textContent = totalRecords;
                $tr.appendChild($indexTd);

                for (let key in user) {
                    if (key === "gender") continue;
                    const $td = document.createElement("td");
                    $td.textContent = user[key];
                    $tr.appendChild($td);
                }
                $tbody.appendChild($tr);
            });

            setupIntersectionObserver();
        }

        let intersectionObserver = null;

        function setupIntersectionObserver() {
            if (intersectionObserver) {
                intersectionObserver.disconnect();
            }

            const lastRow = $tbody.lastElementChild;
            if (!lastRow) return;

            intersectionObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        page++;
                        getData(`${location.protocol}//${location.host}/FakeData/GenerateData?errors=${$controlErrorInput.value}&seed=${$controlSeed.value}&region=${$controlRegion.value}&page=${page}&limit=10`, true);
                    }
                });
            }, {
                root: document.getElementById("tableContainer"),
                rootMargin: "100px",
                threshold: 0.1
            });

            intersectionObserver.observe(lastRow);
        }

        const $controlErrorInput = document.getElementById("control-error-input");
        const $controlErrorSlide = document.getElementById("control-error-slide");
        const $controlSeed = document.getElementById("seed");
        const $controlRegion = document.getElementById("region");
        const $btnRandomSeed = document.getElementById("btn-random-seed");
        const $controlLimit = document.getElementById("limit");

        const currentRegion = $controlRegion.dataset.region;
        if (currentRegion) {
            $controlRegion.value = currentRegion;
        }

        function reloadData() {
            page = 1;
            totalRecords = 0;
            getData(`${location.protocol}//${location.host}/FakeData/GenerateData?errors=${$controlErrorInput.value}&seed=${$controlSeed.value}&region=${$controlRegion.value}&page=${page}&limit=20`, false);
        }

        $controlErrorSlide.addEventListener("change", e => {
            $controlErrorInput.value = e.target.value * 100;
            reloadData();
        });

        $controlErrorInput.addEventListener("change", e => {
            $controlErrorSlide.value = e.target.value / 100;
            reloadData();
        });

        $controlRegion.addEventListener("change", () => reloadData());
        $controlSeed.addEventListener("change", () => reloadData());

        $btnRandomSeed.addEventListener("click", () => {
            $controlSeed.value = Math.round(Math.random() * 10000);
            reloadData();
        });

        const initialLimit = $controlLimit.value || 20;
        getData(`${location.protocol}//${location.host}/FakeData/GenerateData?errors=${$controlErrorInput.value}&seed=${$controlSeed.value}&region=${$controlRegion.value}&page=1&limit=${initialLimit}`, false);

        const $download = document.getElementById("download-file");
        $download.addEventListener("click", () => {
            $download.href = `${location.protocol}//${location.host}/FakeData/GenerateFile?errors=${$controlErrorInput.value}&seed=${$controlSeed.value}&region=${$controlRegion.value}&page=1&limit=${totalRecords || 20}`;
        });
    </script>
</div>
