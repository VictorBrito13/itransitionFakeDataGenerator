<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iTransition DataGen</title>

    <!-- Bootstrap 5.3.3 CSS (CDN with SRI integrity) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons 1.11.3 (CDN with SRI integrity) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+"
          crossorigin="anonymous" />

    <!-- Application Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/itransitionFakeDataGenerator.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- ===================================================================
         HEADER: Glass Navigation Bar
         =================================================================== -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm glass-nav sticky-top"
             style="position: sticky; top: 0; z-index: 1030;">
            <div class="container">
                <!-- Brand: meaningful icon + text -->
                <a class="navbar-brand icon-text" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-database-gear" style="color: var(--color-primary);"></i>
                    <span>iTransition DataGen</span>
                </a>

                <!-- Mobile Toggler: bi-list icon for hamburger -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list" style="font-size: 1.5rem; color: var(--color-text-primary);"></i>
                </button>

                <!-- Navigation Links -->
                <div class="navbar-collapse collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>
                                <span>Home</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ===================================================================
         MAIN: Content Area with glass panel depth layering
         =================================================================== -->
    <main role="main" class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- ===================================================================
         FOOTER: Minimal, subtle
         =================================================================== -->
    <footer class="py-3 mt-auto text-center" style="border-top: 1px solid var(--glass-border);">
        <div class="container">
            <small style="color: var(--color-text-muted);">
                &copy; 2026 iTransition DataGen
            </small>
        </div>
    </footer>

    <!-- ===================================================================
         SCRIPTS
         =================================================================== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap 5.3.3 JS Bundle (CDN with SRI integrity) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
